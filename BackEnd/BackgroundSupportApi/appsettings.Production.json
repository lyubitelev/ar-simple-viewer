{
  // Production-специфичная конфигурация. Секретов здесь нет и быть не должно:
  // SMTP login/password приходят из окружения (AppSettings__Smtp__Login / __Password).
  "AppSettings": {
    // Origin статического сайта (Yandex Object Storage bucket `art-vision-tech`).
    // Дополнительные origin'ы добавляются через AppSettings__AllowedCorsUrls__N,
    // а не расширением CORS до AllowAnyOrigin.
    "AllowedCorsUrls": [
      "https://art-vision-tech.ru"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
