{
  "AppSettings": {
    // smtp-mail.outlook.com
    // Реальные значения задаются только на стороне деплоя:
    // user-secrets в разработке, AppSettings__Smtp__Login / __Password в окружении.
    "Smtp": {
      // should be email
      "Login": "",
      "Password": ""
    },
    // Origin'ы сайта, которым разрешено отправлять заявки. Здесь — только локальная разработка,
    // production-список лежит в appsettings.Production.json.
    "AllowedCorsUrls": [
      "http://localhost:3000",
      "http://192.168.1.56:3000",
      "http://localhost:5502",
      "https://localhost:5502"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5000"
      }
    }
  }
}
